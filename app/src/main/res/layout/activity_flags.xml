<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/flags_title"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"/>

    <Switch
        android:id="@+id/switch_https_only"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/flag_https_only"
        android:layout_marginVertical="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/flag_https_only_desc"
        android:textSize="13sp"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="12dp"
        android:alpha="0.7"/>

    <Switch
        android:id="@+id/switch_cleartext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/flag_cleartext"
        android:layout_marginVertical="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/flag_cleartext_desc"
        android:textSize="13sp"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="12dp"
        android:alpha="0.7"/>

    <Switch
        android:id="@+id/switch_quic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/flag_quic"
        android:layout_marginVertical="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/flag_quic_desc"
        android:textSize="13sp"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="12dp"
        android:alpha="0.7"/>

    <Switch
        android:id="@+id/switch_dark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/flag_dark"
        android:layout_marginVertical="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/flag_dark_desc"
        android:textSize="13sp"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="12dp"
        android:alpha="0.7"/>

    <Switch
        android:id="@+id/switch_adblock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/flag_adblock"
        android:layout_marginVertical="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/flag_adblock_desc"
        android:textSize="13sp"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="12dp"
        android:alpha="0.7"/>

    <Switch
        android:id="@+id/switch_tls13"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/flag_tls13"
        android:layout_marginVertical="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/flag_tls13_desc"
        android:textSize="13sp"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="12dp"
        android:alpha="0.7"/>

</LinearLayout>
